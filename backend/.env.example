# Environment Configuration
# Set ENVIRONMENT to 'local' or 'live' to switch configurations
ENVIRONMENT=local

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,http://yourdomain.com

# Database Configuration - Django-style variables for convenience
DB_ENGINE=mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# App Secret - change this in production
APP_SECRET=your-app-secret-key-change-in-production